#!/usr/bin/env bash

jq -c .$(jq -r 'keys[]' /desktop/devicemaster.json | dmenu -p mode -l 10) /desktop/devicemaster.json | socat STDIO,ignoreeof UNIX-CONNECT:/tmp/devicemaster.socket | jq > /tmp/dmout.json

st -n pop-up -g 120x30 -e $SHELL -c 'nvim /tmp/dmout.json'
exit

cmd=$(echo "
qM                     query current fan mode
g                      set g-mode
q                      set quiet mode
p                      set performance mode
b                      set balanced mode
bS                     set battery saver mode
gT                     toggle g-mode" | \
	sed '1d' | dmenu -p "AWCC: " -l 20 | cut -f 1 -d ' ')
# cmd="${cmd:-qm}"
[ '' = "$cmd" ] && exit

cmd=$(echo "$cmd" | tr '[:upper:]' '[:lower:]')

msg=$(sudo -A awcc "$cmd")
dunstify -r 2222 -t 3000 AWCC "$msg"
